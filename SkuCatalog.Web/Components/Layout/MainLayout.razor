@using SkuCatalog.Web
@inherits LayoutComponentBase

<MudThemeProvider Theme="CatalogTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Toggle navigation" />
        <MudText Typo="Typo.h6" Class="ml-2">SKU Catalog Manager</MudText>
        <MudSpacer />
        <MudButton Href="https://github.com/michelle-nez/sku-catalog-manager" Target="_blank"
                   Color="Color.Inherit" StartIcon="@Icons.Custom.Brands.GitHub" Class="d-none d-sm-flex">
            Source
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always"
               Variant="@DrawerVariant.Responsive">
        <MudNavMenu Rounded="true" Margin="Margin.Dense" Class="pa-2">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">Home</MudNavLink>
            <MudNavLink Href="/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Inventory2">Products</MudNavLink>
            <MudNavLink Href="/products/new" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.AddBox">Add product</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    @* Do not put a pt-* class on MudMainContent - it overrides the padding-top
       MudBlazor uses to clear the fixed AppBar, and the page slides underneath. *@
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 pb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
}
