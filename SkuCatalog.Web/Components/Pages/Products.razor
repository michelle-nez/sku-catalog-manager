@page "/products"
@using Microsoft.EntityFrameworkCore
@using SkuCatalog.Data
@using SkuCatalog.Data.Models
@inject IDbContextFactory<CatalogDbContext> DbFactory

<PageTitle>Products - SKU Catalog Manager</PageTitle>

<div class="d-flex flex-wrap align-center justify-space-between mb-4 gap-3">
    <div>
        <MudText Typo="Typo.h5">Products</MudText>
        @if (products is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @products.Count active @(products.Count == 1 ? "product" : "products")
            </MudText>
        }
    </div>
    <MudButton Href="/products/new" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Outlined.Add">
        Add product
    </MudButton>
</div>

@if (products is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (products.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center" Style="border:1px dashed var(--mud-palette-divider);">
        <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.h6" Class="mt-3">No products yet</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Add your first product to get started.
        </MudText>
        <MudButton Href="/products/new" Variant="Variant.Filled" Color="Color.Primary">Add product</MudButton>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Class="pa-0">
        <MudTable Items="products" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Dense="false">
            <HeaderContent>
                <MudTh>SKU</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Category</MudTh>
                <MudTh Style="text-align:right">Price</MudTh>
                <MudTh Style="text-align:right">Qty</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="SKU">
                    <MudText Typo="Typo.body2" Style="font-family:Consolas,monospace;">@context.Sku</MudText>
                </MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Category">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                        @context.Category?.Name
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Price" Style="text-align:right">@context.Price.ToString("C")</MudTd>
                <MudTd DataLabel="Qty" Style="text-align:right">@context.Quantity</MudTd>
                <MudTd DataLabel="" Style="text-align:right">
                    @if (pendingRetireId == context.Id)
                    {
                        <div class="d-flex align-center justify-end gap-1">
                            <MudText Typo="Typo.caption" Color="Color.Error">Retire?</MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                       OnClick="@(() => RetireAsync(context.Id))">Yes</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       OnClick="@(() => pendingRetireId = null)">Cancel</MudButton>
                        </div>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary"
                                       Href="@($"/products/edit/{context.Id}")" aria-label="Edit" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => pendingRetireId = context.Id)" aria-label="Retire" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<Product>? products;
    private int? pendingRetireId;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // AsNoTracking - these rows are being displayed, not edited.
        products = await db.Products
            .AsNoTracking()
            .Include(p => p.Category)
            .Where(p => p.IsActive)
            .OrderBy(p => p.Sku)
            .ToListAsync();
    }

    private async Task RetireAsync(int productId)
    {
        pendingRetireId = null;

        await using var db = await DbFactory.CreateDbContextAsync();

        var product = await db.Products.FirstOrDefaultAsync(p => p.Id == productId);

        if (product is not null)
        {
            // Hide it, do not destroy it. The list query already filters on IsActive.
            product.IsActive = false;
            await db.SaveChangesAsync();
        }

        await LoadProductsAsync();
    }
}
