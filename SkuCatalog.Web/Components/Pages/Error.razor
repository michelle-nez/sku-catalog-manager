@page "/Error"
@using System.Diagnostics

<PageTitle>Error - SKU Catalog Manager</PageTitle>

<MudPaper Elevation="1" Class="pa-6" Style="max-width:640px;">
    <div class="d-flex align-center gap-3 mb-2">
        <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Color="Color.Error" Size="Size.Large" />
        <MudText Typo="Typo.h5" Color="Color.Error">Something went wrong</MudText>
    </div>

    <MudText Typo="Typo.body1" Class="mb-4">
        An error occurred while processing your request. Nothing was saved.
    </MudText>

    @if (ShowRequestId)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            <MudText Typo="Typo.body2">
                Request ID:
                <span style="font-family:Consolas,monospace;">@RequestId</span>
            </MudText>
        </MudAlert>
    }

    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        This page is shown outside development, so it deliberately gives no detail.
        Running with <strong>ASPNETCORE_ENVIRONMENT</strong> set to
        <strong>Development</strong> shows the full exception instead - never do that
        on a deployed application, because exception detail can expose data.
    </MudText>

    <MudButton Href="/products" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Outlined.ArrowBack">
        Back to products
    </MudButton>
</MudPaper>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
