@page "/products/new"
@page "/products/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using SkuCatalog.Data
@using SkuCatalog.Data.Models
@inject IDbContextFactory<CatalogDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Add product" : "Edit product") - SKU Catalog Manager</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@(Id is null ? "Add product" : "Edit product")</MudText>

@if (product is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudPaper Elevation="1" Class="pa-6" Style="max-width:560px;">
        <EditForm Model="product" OnValidSubmit="SaveAsync" FormName="product-form">
            <DataAnnotationsValidator />

            @if (errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="product.Sku" Label="SKU" For="() => product.Sku"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudTextField @bind-Value="product.Name" Label="Name" For="() => product.Name"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudSelect @bind-Value="product.CategoryId" Label="Category" For="() => product.CategoryId"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem T="int" Value="0">-- choose a category --</MudSelectItem>
                @foreach (var category in categories)
                {
                    <MudSelectItem T="int" Value="@category.Id">@category.Name</MudSelectItem>
                }
            </MudSelect>

            <MudNumericField @bind-Value="product.Price" Label="Price" For="() => product.Price"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Step="0.01M"
                             Format="F2" Class="mb-3" />

            <MudNumericField @bind-Value="product.Quantity" Label="Quantity" For="() => product.Quantity"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />

            <div class="d-flex gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </MudButton>
                <MudButton Href="/products" Variant="Variant.Text">Cancel</MudButton>
            </div>
        </EditForm>
    </MudPaper>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private Product? product;
    private List<Category> categories = new();
    private string? errorMessage;
    private bool isSaving;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        categories = await db.Categories
            .AsNoTracking()
            .OrderBy(c => c.Name)
            .ToListAsync();

        if (Id is null)
        {
            product = new Product();
            return;
        }

        product = await db.Products
            .AsNoTracking()
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (product is null)
        {
            // The id matched nothing. Send them back rather than showing a broken form.
            Nav.NavigateTo("/products");
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        isSaving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (product!.Id == 0)
            {
                db.Products.Add(product);
            }
            else
            {
                db.Products.Update(product);
            }

            await db.SaveChangesAsync();
            Nav.NavigateTo("/products");
        }
        catch (DbUpdateException)
        {
            // The unique index rejected it. Almost always a duplicate SKU.
            errorMessage = $"SKU '{product!.Sku}' is already in use. Pick a different one.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
